{
  "name": "@hatsuportal/platform",
  "version": "1.0.0",
  "description": "",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "npx --yes rimraf lib && npx --yes rimraf tsconfig.tsbuildinfo && npx --yes rimraf coverage",
    "reset": "npm run clean && npx --yes rimraf node_modules"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./lib/index.js"
    },
    "./test": {
      "types": "./lib/test/index.d.ts",
      "import": "./src/test/index.ts",
      "require": "./lib/test/index.js"
    }
  },
  "peerDependencies": {
    "knex": "^3.1.0",
    "pg": "^8.13.1"
  },
  "peerDependenciesMeta": {
    "knex": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "pg": "^8.13.1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hatsuportal/common": "^1.0.0",
    "@hatsuportal/contracts": "^1.0.0",
    "@hatsuportal/shared-kernel": "^1.0.0",
    "colorette": "^2.0.20"
  }
}
